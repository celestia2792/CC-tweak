<frame
    name="app_shell"
    x="1"
    y="1"
    width="{parent.width}"
    height="{parent.height}"
>
    <dialog
        name="dialog"
        boxwidth="32"
        titleBackground="{colors.blue}"
        boxBackground="{colors.lightGray}"
        boxForeground="{colors.black}"
    />
    <label
        x="1"
        y="1"
        text="Screen Connection"
    />
    <button
        x="{parent.width - 5}"
        y="1"
        width="6"
        height="1"
        background="{colors.red}"
        text="Exit"
        onClick="exit"
    />
    <list
        name="connection_list"
        x="2"
        y="4"
        width="{parent.width/2}"
        height="{parent.height - 4}"
        emptyText="No connections"
        scrollbar="auto"
    />
    <frame
        x="{parent.width/2 + 3}"
        y="4"
        width="{parent.width/2 - 4}"
        height="{parent.height - 4}"
    >
        <label
            x="1"
            y="1"
            text="New Connection Info"
        />
        <dropdown
            name="monitor_dropdown"
            x="1"
            y="3"
            width="{parent.width - 1}"
            text="Select Monitor"
            background="{colors.black}"
            dropBackground="{colors.black}"
        />
        <dropdown
            name="program_dropdown"
            x="1"
            y="5"
            width="{parent.width - 1}"
            text="Select Program"
            background="{colors.black}"
            dropBackground="{colors.black}"
        />
        <button
            x="1"
            y="7"
            width="4"
            height="1"
            background="{colors.green}"
            text="Add"
            onClick="addNewConnection"
        />
        <button
            x="6"
            y="7"
            width="8"
            height="1"
            background="{colors.red}"
            text="Remove"
            onClick="removeConnection"
        />
        <button
            x="1"
            y="9"
            width="4"
            height="1"
            background="{colors.green}"
            text="Run"
            onClick="runBtnPressed"
        />
        <button
            x="6"
            y="9"
            width="8"
            height="1"
            background="{colors.red}"
            text="Stop"
            onClick="stopBtnPressed"
        />
        <label
            name="outUnit"
            x="1"
            y="11"
            width="{parent.width - 1}"
            height="5"
            background="{colors.black}"
        />
    </frame>
</frame>