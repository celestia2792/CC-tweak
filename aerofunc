while true do
    local pos = sublevel.getLastPose()
    local w = pos.orientation.a
    local x, y, z = pos.orientation.v.x, pos.orientation.v.y, pos.orientation.v.z
    local yaw = math.deg(math.atan2(
        2 * (w * y + x * z),
        1 - 2 * (y * y + z * z)
    ))
    print(yaw)
    sleep(0.5)
end